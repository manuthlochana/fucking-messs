# ==========================================================================
# KALA-BALANA Environment Configuration
# ==========================================================================

# ---- LLM: Gemini (Required) ----
# Comma-separated list for multi-key rotation pool (recommended for production).
# Falls back to GEMINI_API_KEY for single-key setups.
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=                   # fallback single key
GOOGLE_API_KEY=                   # also accepted
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DISABLE_THINKING=true      # disable 'thinking' on the Sentry hot path
GEMINI_RPM_LIMIT=15               # Gemini free-tier RPM cap
LLM_RPM_SAFETY_MARGIN=0.80        # treat 80% of RPM as the operational ceiling

# ---- LLM: Groq Fallback (Optional) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_RPM_LIMIT=30

# ---- Database: PostgreSQL + pgvector (Optional, enables persistence) ----
# Leave empty to run in dry-run mode (no DB calls).
DB_DSN=postgresql://postgres:password@localhost:5432/kala_balana
DB_POOL_MAX_SIZE=5               # connections; safe for 2-core 4GB VPS
DB_POOL_MIN_SIZE=1

# ---- FX / Arbitrage (Phase 2) ----
FX_API_URL=https://open.er-api.com/v6/latest/USD
IMPORT_DUTY_FACTOR=1.075         # 7.5% combined import + VAT estimate
FX_CACHE_TTL_S=86400             # cache live USD/LKR + AED/LKR for 24h
# When set, the keyed ExchangeRate-API v6 endpoint is preferred over the open one.
EXCHANGERATE_API_KEY=

# ---- Real defect mining: web search (Phase 3) ----
# Provider auto-selects from whichever key is present, or force via SEARCH_PROVIDER
# (tavily | brave | serpapi | none). With NO key, defect mining degrades to
# confidence_label='low_data' and NEVER fabricates defects.
SEARCH_PROVIDER=                 # leave blank to auto-detect from the keys below
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=5

# ---- Autonomous discovery & drip crawling (Step 1) ----
DISCOVERY_MAX_SPIDER_PAGES=500   # BFS spider ceiling when no sitemap is found
DRIP_DAILY_PAGE_LIMIT=1500       # polite pages/day per domain
DRIP_MIN_DELAY_S=4.0             # per-request jitter floor (same-domain)
DRIP_MAX_DELAY_S=12.0            # per-request jitter ceiling
DRIP_MAX_CONCURRENCY=2           # hard cap on concurrent same-domain fetches
DRIP_CONTEXT_RECYCLE_PAGES=100   # recycle the HTTP client every N pages
DRIP_MEM_SOFT_LIMIT_MB=1500      # pause workers above this RSS (GC guard)
CIRCUIT_BREAKER_THRESHOLD=5      # consecutive 403/429/503 before tripping
CIRCUIT_BREAKER_COOLDOWN_S=3600  # pause duration once tripped (60 min)

# ---- Forensic Phase Timeouts (seconds) ----
FORENSIC_PHASE1_TIMEOUT_S=60
FORENSIC_PHASE2_TIMEOUT_S=60
FORENSIC_PHASE3_TIMEOUT_S=90
FORENSIC_PHASE4_TIMEOUT_S=60
FORENSIC_PHASE5_TIMEOUT_S=30

# ---- YouTube API (Phase 3, optional) ----
YOUTUBE_API_KEY=

# ---- Sentry / LLM ----
SENTRY_TOKEN_BUDGET=2000          # tokens of content shown to the classifier
CHARS_PER_TOKEN=4
MIN_DOM_LENGTH=500                # below this raw-DOM size -> junk pre-LLM
LLM_MAX_RETRIES=2

# ---- Crawler guardrails ----
MAX_CONCURRENCY=2                 # concurrent browser tabs (4GB VPS safe)
MAX_PAGES=50                      # hard ceiling per batch
MAX_DEPTH=2                       # category-expansion recursion limit
MAX_CHILDREN_PER_CATEGORY=20

# ---- Browser / network ----
HEADLESS=true
PAGE_TIMEOUT_MS=30000
STEALTH_PAGE_TIMEOUT_MS=45000
STEALTH_SETTLE_MS=2500
# PROXY=http://user:pass@host:port
# USER_AGENT=
CRAWLER_NO_SANDBOX=false          # set true when running as root in a container

# ---- Optional Redis-backed hash ring ----
# REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=sentry

# ---- Admin dashboard security ----
# When ADMIN_DASHBOARD_KEY is set, every dashboard route requires HTTP Basic
# auth (username = ADMIN_DASHBOARD_USER, password = the key) and state-changing
# POSTs (/ingest, /queue/retry) additionally require a CSRF token equal to the
# key (csrf_token form field or X-CSRF-Token header). Leave it UNSET only for a
# trusted localhost session — the dashboard then runs unauthenticated and logs
# a loud warning at startup.
# ADMIN_DASHBOARD_KEY=change-me-to-a-long-random-secret
ADMIN_DASHBOARD_USER=admin
